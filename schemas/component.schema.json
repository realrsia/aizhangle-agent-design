{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangle.local/schemas/component.schema.json",
  "title": "Zhangle Component Meta",
  "type": "object",
  "required": [
    "id",
    "kind",
    "schemaVersion",
    "version",
    "status",
    "title",
    "summary",
    "taxonomy",
    "tokens",
    "variants",
    "states",
    "usageRules",
    "review"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^component\\.[a-z0-9.-]+$" },
    "kind": { "const": "component" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "beta", "stable", "deprecated"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "owners": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "taxonomy": {
      "type": "object",
      "required": ["family", "platforms", "productLines"],
      "properties": {
        "family": { "type": "string" },
        "subfamily": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "productLines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "props": { "type": "object" },
    "slots": { "type": "object" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tokens": { "type": "object" },
          "usage": { "type": "string" },
          "aiWarning": { "type": "string" }
        }
      }
    },
    "states": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tokens": {
      "type": "object",
      "required": ["base", "semantic"],
      "properties": {
        "base": { "type": "object" },
        "semantic": { "type": "object" }
      }
    },
    "usageRules": {
      "type": "object",
      "properties": {
        "do": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dont": {
          "type": "array",
          "items": { "type": "string" }
        },
        "businessScenarios": { "type": "object" },
        "humanOwned": { "type": "boolean" }
      }
    },
    "accessibility": { "type": "object" },
    "layoutRules": { "type": "object" },
    "figmaBinding": { "type": "object" },
    "resourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "locator"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "locator": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "summary"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "enum": ["P0", "P1", "P2", "P3"] },
              "summary": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
