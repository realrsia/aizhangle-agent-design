{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangle.local/schemas/resource.schema.json",
  "title": "Zhangle Resource Reference",
  "type": "object",
  "required": ["id", "kind", "type", "locator"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "const": "resourceRef" },
    "type": {
      "enum": [
        "figma-file",
        "figma-variable",
        "figma-component",
        "figma-node",
        "local-asset",
        "doc",
        "code"
      ]
    },
    "assetKind": { "type": "string" },
    "locator": {},
    "meta": { "type": "object" }
  },
  "additionalProperties": true
}
