{
  "name": "trading-input-component",
  "description": "Machine-readable structure template for New Zhanle trading input components.",
  "appliesTo": [
    "代码输入",
    "数字步进输入",
    "下拉选择",
    "数字步进输入+下拉选择",
    "条件输入"
  ],
  "tokens": {
    "inputBackground": "xzl/color/input/background",
    "placeholderText": "xzl/color/text/quaternary",
    "enteredText": "xzl/color/text/primary",
    "iconDefault": "xzl/color/text/quaternary",
    "labelSwitchIcon": "xzl/color/text/primary",
    "disabledOpacity": 0.4
  },
  "metrics": {
    "height": 36,
    "radius": 4,
    "defaultFontSize": 16,
    "fallbackFontSizes": [
      13,
      12
    ],
    "overflowAfterMinimum": "ellipsis",
    "textWrapDefault": false,
    "iconSize": {
      "default": {
        "width": 20,
        "height": 20
      },
      "labelSwitch": {
        "width": 14,
        "height": 14
      }
    }
  },
  "icons": {
    "search": "assets/icons/search-outlined.svg",
    "clear": "assets/icons/close-circle-filled.svg",
    "dropdown": "assets/icons/arrow.svg",
    "minus": "assets/icons/minus-outlined.svg",
    "plus": "assets/icons/plus-outlined.svg",
    "delete": "assets/icons/delete-outlined.svg",
    "edit": "assets/icons/pen-outlined.svg",
    "switch": "assets/icons/switch-outlined.svg"
  },
  "components": {
    "codeInput": {
      "states": {
        "empty": [
          "placeholderText",
          "searchIcon"
        ],
        "entered": [
          "enteredSecurityText",
          "clearIcon"
        ],
        "disabled": [
          "enteredSecurityText",
          "clearIcon"
        ]
      },
      "spacing": {
        "leftInset": 42,
        "textVerticalPadding": 7,
        "iconLeftSpacing": 15,
        "iconRightSpacing": 8
      }
    },
    "numericStepperInput": {
      "states": {
        "empty": [
          "minusIcon",
          "placeholderText",
          "plusIcon"
        ],
        "focused": [
          "minusIcon",
          "caret",
          "plusIcon"
        ],
        "inputting": [
          "minusIcon",
          "valueText",
          "caret",
          "plusIcon"
        ],
        "entered": [
          "minusIcon",
          "valueText",
          "plusIcon"
        ],
        "disabled": [
          "minusIcon",
          "valueText",
          "plusIcon"
        ]
      },
      "textAlignment": "center",
      "hideStepperWhileInputting": false,
      "spacing": {
        "sideIconSpacing": 8,
        "textVerticalPadding": 7,
        "textToPlusSpacing": 15
      }
    },
    "dropdownInput": {
      "states": {
        "empty": [
          "placeholderText",
          "dropdownIcon"
        ],
        "entered": [
          "selectedText",
          "dropdownIcon"
        ],
        "disabled": [
          "selectedText",
          "dropdownIcon"
        ]
      },
      "spacing": {
        "leftInset": 42,
        "textVerticalPadding": 7,
        "iconLeftSpacing": 15,
        "iconRightSpacing": 8
      }
    },
    "numericStepperDropdownInput": {
      "states": {
        "empty": [
          "minusIcon",
          "placeholderText",
          "dropdownIcon",
          "plusIcon"
        ],
        "focused": [
          "minusIcon",
          "caret",
          "dropdownIcon",
          "plusIcon"
        ],
        "inputting": [
          "minusIcon",
          "valueText",
          "caret",
          "dropdownIcon",
          "plusIcon"
        ],
        "entered": [
          "minusIcon",
          "valueText",
          "dropdownIcon",
          "plusIcon"
        ],
        "disabled": [
          "minusIcon",
          "valueText",
          "dropdownIcon",
          "plusIcon"
        ]
      },
      "textAlignment": "center",
      "spacing": {
        "minusSideSpacing": 8,
        "textVerticalPadding": 7,
        "textToDropdownSpacing": 15,
        "dropdownToPlusSpacing": 8,
        "plusSideSpacing": 8
      }
    },
    "conditionInput": {
      "states": {
        "empty": [
          "emptyText",
          "editIcon"
        ],
        "entered": [
          "conditionText",
          "deleteIcon",
          "editIcon"
        ],
        "disabled": [
          "conditionText",
          "deleteIcon",
          "editIcon"
        ]
      },
      "hasFocusedState": false,
      "deleteIconAppearsOnlyWhenEntered": true,
      "spacing": {
        "textVerticalPadding": 7,
        "iconGap": 5,
        "outerIconSideSpacing": 8
      }
    }
  },
  "validation": [
    "Input height is 36px and radius is 4px.",
    "Use xzl/color/input/background for filled input backgrounds.",
    "Use xzl/color/text/quaternary for placeholder text and default input icons.",
    "Use xzl/color/text/primary for entered text and the quantity/amount switch icon.",
    "Disabled background, icon, and symbol nodes apply 40% opacity.",
    "Only the middle text region changes width when the component adapts.",
    "Text scales 16 -> 13 -> 12, then ellipsis.",
    "Numeric stepper values are centered and plus/minus remain visible during input.",
    "Condition input has no focused state in this version."
  ]
}
