{
  "securityTags": {
    "neutralOutline": {
      "labels": [
        "沪A",
        "ETF"
      ],
      "light": {
        "text": "#030303",
        "border": "30% #030303"
      },
      "dark": {
        "text": "90% #FFFFFF",
        "border": "30% #FFFFFF"
      },
      "scope": "ordinary neutral security labels",
      "excludes": [
        "信用"
      ]
    },
    "blueOutline": {
      "labels": [
        "科创",
        "美股",
        "条件单"
      ],
      "light": {
        "text": "#105EFF",
        "border": "50% #105EFF"
      },
      "dark": {
        "text": "#3B84FF",
        "border": "50% #3B84FF"
      },
      "scope": "technology/security labels and holding-list trade-type 条件单"
    },
    "purpleOutline": {
      "labels": [
        "港股"
      ],
      "light": {
        "text": "#5A43EB",
        "border": "50% #5A43EB"
      },
      "dark": {
        "text": "#9481FF",
        "border": "50% #9481FF"
      }
    },
    "orangeOutline": {
      "labels": [
        "融"
      ],
      "light": {
        "text": "#F36C29",
        "border": "50% #F36C29"
      },
      "dark": {
        "text": "#E97B2E",
        "border": "50% #E97B2E"
      }
    },
    "metrics": {
      "lineHeight": 14,
      "paddingHorizontal": 1.5,
      "paddingVertical": 0,
      "radius": 2,
      "mustReferenceInDenseLists": true
    },
    "shortDisplayLabels": {
      "沪A": "沪",
      "科创": "创",
      "创业": "创",
      "港股": "港",
      "美股": "USA"
    },
    "shortDisplayScope": "dense financial lists only",
    "preserveFullSemanticLabel": true,
    "brownOutline": {
      "labels": [
        "信用"
      ],
      "scope": "all 信用 tags",
      "light": {
        "textToken": "xzl/color/primary/brown",
        "border": "50% xzl/color/primary/brown"
      },
      "dark": {
        "textToken": "xzl/color/primary/brown",
        "border": "50% xzl/color/primary/brown"
      },
      "overridesGenericNeutralForHoldingList": true,
      "sourceRule": "references/tags/security-tags.md#use-brown-outline-for-信用",
      "reuseMetrics": "securityTags.metrics"
    }
  },
  "signalTags": {
    "peerLeading": {
