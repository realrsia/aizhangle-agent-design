{
  "fontFamily": {
    "text": "PingFang SC",
    "number": "涨乐财富体"
  },
  "financialTableList": {
    "rowHeightDefault": 60,
    "headerHeight": 29,
    "headerSortIconHitArea": {
      "width": 6,
      "height": 12
    },
    "headerText": {
      "fontFamily": "PingFang SC",
      "fontSize": 12,
      "fontWeight": "regular",
      "colorToken": "xzl/color/text/tertiary",
      "cssFontWeight": 400,
      "sortIconGap": 2
    },
    "stockName": {
      "fontFamily": "PingFang SC",
      "fontSize": 16,
      "minimumFontSize": 12,
      "fontWeight": "medium",
      "cssFontWeight": 500
    },
    "stockCode": {
      "fontFamily": "涨乐财富体",
      "fontSize": 12,
      "fontWeight": "regular"
    },
    "dataNumber": {
      "fontFamily": "涨乐财富体",
      "fontSize": 16,
      "fontWeight": "regular"
    },
    "holdingsMarketValue": {
      "fontFamily": "涨乐财富体",
      "fontSize": 12,
      "fontWeight": "regular",
      "colorToken": "xzl/color/text/tertiary"
    },
    "layout": {
      "leftScreenInset": 18,
      "rightScreenInset": 18,
      "listVerticalPadding": 10,
      "columnGap": 10,
      "dividerWidth": 0.5,
      "dividerColorToken": "xzl/color/divider/sheet",
      "dividerLeftInset": 18,
      "headerBodyDividerWidth": 0.5,
      "headerBodyDividerColorToken": "xzl/color/divider/sheet",
      "headerBodyDividerLeftInset": 18,
      "dividerRightInset": 0,
      "headerBodyDividerRightInset": 0
    },
    "columns": {
      "watchlistFrozenNameWidth": 123,
      "holdingsFrozenNameWidth": 143,
      "miniTrendColumnWidth": 62,
      "miniTrendSize": {
        "width": 62,
        "height": 40
      },
      "dataColumnWidth": 70
    },
    "valueDisplay": {
      "empty": "--",
      "flatPercent": "0.00%",
      "flatColorToken": "xzl/color/text/primary",
      "holdingsFrozenMaskedValue": "****",
      "holdingsSensitiveMaskedValue": "*****"
    },
    "headerSortIcon": {
      "asset": "assets/icons/table-sort-arrows.svg",
      "defaultColorToken": "xzl/color/text/tertiary",
      "activeColorToken": "xzl/color/primary/red",
      "textGap": 2,
      "displaySize": {
        "width": 6,
        "height": 12
      },
      "hitArea": {
        "width": 6,
        "height": 12
      }
    },
    "stockNameCodeGap": 1,
    "alignment": {
      "frozenColumnHeader": "left",
      "frozenColumnData": "left",
      "scrollingColumnHeader": "right",
      "scrollingColumnData": "right",
      "miniTrendColumn": "fixed-area"
    },
    "watchlistNameHeaderTools": {
      "icons": [
        {
          "name": "编辑",
          "asset": "assets/icons/watchlist-header-edit.svg"
        },
        {
          "name": "标签视图切换",
          "asset": "assets/icons/watchlist-header-tag-view.svg"
        },
        {
          "name": "多股",
          "asset": "assets/icons/watchlist-header-multi-stock.svg"
        },
        {
          "name": "横屏",
          "asset": "assets/icons/watchlist-header-landscape.svg"
        }
      ],
      "designSize": {
        "width": 16,
        "height": 16
      },
      "hitArea": {
        "width": 16,
        "height": 16
      },
      "gap": 9.5,
      "colorToken": "xzl/color/text/tertiary",
      "layout": {
        "containerWidth": 123,
        "xStart": 0,
        "direction": "left-to-right",
        "eachIconIsClickableAction": true,
        "figmaLayerName": "watchlistHeaderTools",
        "frontendRole": "toolbar"
      }
    },
    "headerBodyColumnBinding": {
      "headerUsesSameColumnModelAsBody": true,
      "frozenHeaderCellWidthEqualsFrozenBodyColumn": true,
      "frozenHeaderCellFixed": true,
      "scrollingHeaderAreaSyncsWithBodyScroll": true,
      "headerNoWrap": true
    },
    "frozenLayer": {
      "opaqueBackgroundRequired": true,
      "maskFromViewportLeftEdge": true,
      "rendersAboveScrollingColumns": true,
      "preventLeftInsetDataLeak": true,
      "backgroundTokenSource": "page background token"
    },
    "requiredGenerationSections": [
      "frozen header cell",
      "scrolling header row",
      "frozen body column",
      "scrolling body columns",
      "header/body column-width mapping",
      "required assets list"
    ],
    "fontWeightMapping": {
      "PingFang SC Regular": 400,
      "PingFang SC Medium": 500
    },
    "implementationSkeleton": {
      "figma": [
        "frozenHeaderLayer",
        "scrollHeaderLayer",
        "frozenBodyLayer",
        "scrollBodyLayer",
        "dividerOverlayLayer"
      ],
      "frontend": {
        "frozenLayerOutsideHorizontalScroll": true,
        "scrollLayerOwnsHorizontalTransform": true,
        "dividerOverlayAboveContent": true,
        "frozenLayerUsesPageBackground": true
      },
      "forbidden": [
        "frozen column inside horizontal scroll container",
        "frozen column follows horizontal transform",
        "divider clipped by frozen mask",
        "scrolling content visible in left inset"
      ]
    },
    "dividerOverlay": {
      "xStart": 18,
      "rightInset": 0,
      "aboveFrozenAndScrollContent": true,
      "matchesFirstContentStartAndLastContentEnd": true,
      "layerAbove": [
        "frozenHeaderLayer",
        "frozenBodyLayer",
        "scrollHeaderLayer",
        "scrollBodyLayer"
      ],
      "mustNotBeClippedByFrozenLayer": true
    },
    "filterableHeaderTemplate": "assets/templates/filterable-table-header.json",
    "defaultListModel": {
      "newZhanleFinancialListsDefaultToTable": true,
      "simpleRowListRequiresExplicitRequest": true,
      "simpleRowListTriggerWords": [
        "简版",
        "卡片式",
        "非表格",
        "不需要表头",
        "不需要横向滑动",
        "只展示少量字段"
      ]
    },
    "horizontalScrollContract": {
      "headerHasIndependentHorizontalScroll": false,
      "headerFollowsBodyHorizontalScrollState": true,
      "sharedColumnModelRequired": true,
      "misalignmentIsAuditFinding": true
    },
    "generationOrder": [
      "defineColumnModel",
      "renderHeadersFromColumnModel",
      "renderRowsFromColumnModel",
      "bindScrollState"
    ]
  },
  "watchlist": {
    "columns": [
      "名称代码",
      "K线图",
      "最新",
      "涨幅",
      "涨跌",
      "涨速",
      "成交额",
      "换手率"
    ],
    "movementColumns": [
      "K线图",
      "涨幅",
      "涨跌",
      "涨速"
    ],
    "ordinaryColumns": [
      "最新",
      "成交额",
      "换手率"
    ],
    "miniTrendStates": [
      "5日",
      "分时",
      "日K"
    ],
    "miniTrendBindings": {
      "5日": "figma-mini-trend-5d",
      "分时": "figma-mini-trend-minute",
      "日K": "figma-mini-trend-daily-k"
    },
    "filterableColumns": [
      "最新",
      "涨幅",
      "涨跌",
      "涨速",
      "成交额",
      "换手率"
    ],
    "requiredHeaderAssets": [
      "assets/icons/watchlist-header-edit.svg",
      "assets/icons/watchlist-header-tag-view.svg",
      "assets/icons/watchlist-header-multi-stock.svg",
      "assets/icons/watchlist-header-landscape.svg"
    ],
    "requiredFilterIconAsset": "assets/icons/table-sort-arrows.svg",
    "watchlistHeaderToolsTemplate": "assets/templates/watchlist-header-tools.json",
    "watchlistTableModuleTemplate": "assets/templates/watchlist-table-module.json",
    "columnIds": {
      "名称代码": "nameCode",
      "K线图": "miniTrend",
      "最新": "latest",
      "涨幅": "changePercent",
      "涨跌": "changeAmount",
      "涨速": "changeSpeed",
      "成交额": "turnoverAmount",
      "换手率": "turnoverRate"
    },
    "miniTrendState": {
      "allowedValues": [
        "5日",
        "分时",
        "日K"
      ],
      "default": "5日",
      "scope": "list-instance",
      "singleStatePerInstance": true,
      "noMixedAssetsWithinInstance": true
    }
  },
  "holdings": {
    "columns": [
      "名称",
      "持仓金额",
      "持仓盈亏",
      "持仓/可用",
      "现价/成本",
      "今日盈亏",
      "个股仓位",
      "持仓天数",
      "买入均价",
      "代码",
      "最新",
      "涨幅",
      "涨跌",
      "涨速",
      "成交额",
      "换手率"
    ],
    "movementColumns": [
      "持仓盈亏",
      "今日盈亏",
      "涨幅",
      "涨跌",
      "涨速"
    ],
    "privacyMaskedColumns": [
      "持仓盈亏",
      "持仓/可用",
      "现价/成本",
      "今日盈亏",
      "个股仓位",
      "持仓天数",
      "买入均价"
    ],
    "dualLineFields": {
      "持仓/可用": {
        "top": "持仓",
        "bottom": "可用"
      },
      "现价/成本": {
        "top": "现价",
        "bottom": "成本"
      },
      "持仓盈亏": {
        "top": "盈亏金额",
        "bottom": "盈亏百分比"
      }
    },
    "filterableColumns": [
      "名称",
      "持仓盈亏",
      "持仓/可用",
      "现价/成本",
      "今日盈亏",
      "个股仓位",
      "持仓天数",
      "买入均价",
      "最新",
      "涨幅",
      "涨跌",
      "涨速",
      "成交额",
      "换手率"
    ],
    "usesWatchlistHeaderTools": false,
    "dualLineText": {
      "topMain": {
        "fontFamily": "涨乐财富体",
        "fontWeight": "regular",
        "cssFontWeight": 400,
        "fontSize": 16,
        "alignment": "right"
      },
      "bottomSecondary": {
        "fontFamily": "涨乐财富体",
        "fontWeight": "regular",
        "cssFontWeight": 400,
        "fontSize": 12,
        "alignment": "right",
        "ordinaryColorToken": "xzl/color/text/tertiary",
        "movementUsesRedGreenSemantics": true
      }
    }
  },
  "tagCountCapsule": {
    "meaning": "security tag count",
    "showPlusSign": false,
    "fontFamily": "涨乐财富体",
    "fontWeight": "regular",
    "cssFontWeight": 400,
    "fontSize": 11,
    "containerStyle": "securityTags.neutralOutline",
    "notMovementValue": true,
    "defaultDisplay": false,
    "useOnlyWhen": "real security tags cannot fit in the current stock identity area",
    "overflowAdaptationOnly": true,
    "preferRealSecurityTagText": true
  },
  "holdingList": {
    "scenarioName": "持股列表",
    "tableModuleTemplate": "assets/templates/holding-table-module.json",
    "leftFrozenHeaderTemplate": "assets/templates/holding-list-left-header.json",
    "outputChecklist": "assets/templates/holding-output-checklist.json",
    "frozenWidth": 143,
    "leftHeader": {
      "xStart": 0,
      "groupGap": 6,
      "groups": [
        {
          "id": "marketValueSort",
          "label": "市值",
          "icon": "assets/icons/table-sort-arrows.svg",
          "onlyIconClickable": true
        },
        {
          "id": "edit",
          "label": "编辑",
          "icon": "assets/icons/watchlist-header-edit.svg"
        },
        {
          "id": "multiStock",
          "label": "多股",
          "icon": "assets/icons/watchlist-header-multi-stock.svg"
        }
      ],
      "text": {
        "fontFamily": "PingFang SC",
        "fontSize": 12,
        "cssFontWeight": 400,
        "colorToken": "xzl/color/text/tertiary"
      }
    },
    "frozenRows": {
      "line1": "stockName",
      "line2": [
        "marketValueAmount",
        "tradeTypeTag"
      ],
      "showStockCode": false,
      "showSecurityTags": false,
      "marketValueAmount": {
        "fontFamily": "涨乐财富体",
        "fontSize": 12,
        "fontWeight": "regular",
        "colorToken": "xzl/color/text/tertiary"
      },
      "tradeTypeTags": [
        "条件单",
        "信用"
      ]
    },
    "usesWatchlistHeaderTools": false,
    "headerIconsUseApprovedAssets": true,
    "standaloneHtmlIconRendering": {
      "preferInlineSvg": true,
      "allowCopiedRelativeAssets": true,
      "forbidHandDrawnApproximation": true,
      "forbidExternalAbsoluteSvgOnly": true,
      "forbidCssMaskOnly": true,
      "visibleGeometryRequired": true
    },
    "horizontalScroll": {
      "lastColumnFullyVisible": true,
      "lastFieldExample": "换手率",
      "rightSafetyPadding": 18,
      "headerBodyScrollSynced": true
    },
    "tradeTypeTags": {
      "rulePriority": "above generic security tag rules in holding frozen column",
      "allowed": [
        "条件单",
        "信用"
      ],
      "placement": "after second-line market value amount",
      "conditionsOrder": "currently single tag only; no multi-tag overflow rule",
      "styles": {
        "条件单": {
          "styleRef": "securityTags.blueOutline"
        },
        "信用": {
          "styleRef": "securityTags.brownOutline",
          "notGenericSecurityNeutral": true
        }
      },
      "styleSource": "assets/tokens/tag-tokens.json",
      "reuseMetrics": "securityTags.metrics"
    }
  }
}
