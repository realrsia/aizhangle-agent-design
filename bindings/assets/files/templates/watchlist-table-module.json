{
  "name": "watchlist-table-module",
  "description": "Required structure template for a 自选列表 module, including the frozen header tools, scrolling filterable headers, frozen identity rows, and synchronized scrolling data columns.",
  "appliesTo": [
    "watchlist",
    "自选列表",
    "complete 自选 page containing a 自选列表 module"
  ],
  "requiredReferences": [
    "references/lists/table-generation-protocol.md",
    "references/lists/financial-table-list.md",
    "references/lists/watchlist.md",
    "references/lists/watchlist-generation.md",
    "references/tags/security-tags.md"
  ],
  "module": {
    "type": "financialTableList",
    "scenario": "watchlist",
    "pageContainerAllowed": true,
    "pageChromeMayExist": true,
    "pageChromeCannotReplaceModule": true,
    "frozenHeader": {
      "width": 123,
      "template": "assets/templates/watchlist-header-tools.json",
      "mustRenderChildren": true,
      "displayNameCodeText": false,
      "children": [
        "assets/icons/watchlist-header-edit.svg",
        "assets/icons/watchlist-header-tag-view.svg",
        "assets/icons/watchlist-header-multi-stock.svg",
        "assets/icons/watchlist-header-landscape.svg"
      ],
      "columnId": "nameCode",
      "overrideGenericFrozenHeader": true,
      "mustNotBeBlank": true,
      "mustNotDisplayText": "名称代码"
    },
    "scrollHeader": {
      "sharesHorizontalScrollStateWithBody": true,
      "headerCannotScrollIndependently": true,
      "columns": [
        {
          "field": "K线图",
          "width": 62,
          "header": "blank",
          "filterable": false,
          "columnId": "miniTrend"
        },
        {
          "field": "最新",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "latest",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        },
        {
          "field": "涨幅",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changePercent",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        },
        {
          "field": "涨跌",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changeAmount",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        },
        {
          "field": "涨速",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changeSpeed",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        },
        {
          "field": "成交额",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "turnoverAmount",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        },
        {
          "field": "换手率",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "turnoverRate",
          "headerChildren": [
            "labelText",
            "sortFilterIcon"
          ],
          "alignment": "right",
          "sharesRightEdgeWithBody": true
        }
      ]
    },
    "frozenRows": {
      "width": 123,
      "children": [
        {
          "name": "stockName",
          "required": true,
          "priority": 1
        },
        {
          "name": "stockCode",
          "required": true,
          "priority": 2
        },
        {
          "name": "securityTagsInline",
          "required": false,
          "priority": 3,
          "defaultBehavior": "show real security tag text when it fits",
          "styleSource": "assets/tokens/tag-tokens.json",
          "ruleSource": "references/tags/security-tags.md"
        },
        {
          "name": "securityTagOverflowCount",
          "required": false,
          "priority": 4,
          "useOnlyWhen": "real security tags cannot fit in the current stock identity area",
          "notDefault": true
        }
      ],
      "columnId": "nameCode"
    },
    "scrollRows": {
      "sharesColumnModelWithHeader": true,
      "cells": [
        {
          "columnId": "miniTrend",
          "field": "K线图"
        },
        {
          "columnId": "latest",
          "field": "最新"
        },
        {
          "columnId": "changePercent",
          "field": "涨幅"
        },
        {
          "columnId": "changeAmount",
          "field": "涨跌"
        },
        {
          "columnId": "changeSpeed",
          "field": "涨速"
        },
        {
          "columnId": "turnoverAmount",
          "field": "成交额"
        },
        {
          "columnId": "turnoverRate",
          "field": "换手率"
        }
      ]
    },
    "generationOrder": [
      "defineColumnModel",
      "renderFrozenHeaderFromColumnModel",
      "renderScrollHeaderFromColumnModel",
      "renderFrozenRowsFromColumnModel",
      "renderScrollRowsFromColumnModel",
      "bindHeaderAndBodyToOneHorizontalScrollState"
    ],
    "columnModel": [
      {
        "columnId": "nameCode",
        "field": "名称代码",
        "width": 123,
        "role": "frozenIdentity",
        "alignment": "left",
        "headerTemplate": "assets/templates/watchlist-header-tools.json",
        "overrideGenericFrozenHeader": true,
        "mustNotBeBlank": true,
        "mustNotDisplayText": "名称代码"
      },
      {
        "columnId": "miniTrend",
        "field": "K线图",
        "width": 62,
        "role": "scrollingVisual",
        "alignment": "fixed-area",
        "header": "blank",
        "filterable": false
      },
      {
        "columnId": "latest",
        "field": "最新",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      },
      {
        "columnId": "changePercent",
        "field": "涨幅",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      },
      {
        "columnId": "changeAmount",
        "field": "涨跌",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      },
      {
        "columnId": "changeSpeed",
        "field": "涨速",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      },
      {
        "columnId": "turnoverAmount",
        "field": "成交额",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      },
      {
        "columnId": "turnoverRate",
        "field": "换手率",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "headerChildren": [
          "labelText",
          "sortFilterIcon"
        ],
        "sharesRightEdgeWithBody": true,
        "filterable": true
      }
    ],
    "miniTrendState": {
      "allowedValues": [
        "5日",
        "分时",
        "日K"
      ],
      "default": "5日",
      "scope": "list-instance",
      "singleStatePerInstance": true,
      "noMixedAssetsWithinInstance": true,
      "stateAttribute": "data-chart-state"
    }
  },
  "validation": [
    "The four watchlist header tool icons must be rendered child nodes, not notes.",
    "Every filterable header must render labelText plus sortFilterIcon.",
    "The K线图 header cell is blank.",
    "Header and body share one horizontal scroll state.",
    "Show real security tags by default; use numeric overflow count only when tags do not fit.",
    "The numeric overflow count is not a default badge and must not use + or movement colors.",
    "Define the columnModel before rendering header or row cells.",
    "The watchlist frozen header overrides the generic frozen header and must not be blank.",
    "Header and body cells must reference the same columnId.",
    "Filterable header cells use labelText plus sortFilterIcon inside the same right-aligned column box.",
    "Declare miniTrendState once per watchlist instance; default to 5日 when unspecified.",
    "All mini trend rows in one watchlist instance use the same state asset family."
  ]
}
