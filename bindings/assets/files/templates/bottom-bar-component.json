{
  "name": "bottom-bar-component",
  "description": "Reusable structure and metrics for New Zhanle AI bottom bars.",
  "variants": {
    "primaryPage": {
      "appliesTo": [
        "首页",
        "自选",
        "持仓",
        "primary first-level pages"
      ],
      "metrics": {
        "bodyHeight": 48,
        "shadowHeight": 130,
        "inputHeight": 48,
        "safeAreaHeight": 34,
        "contentToBodyGap": 20
      },
      "backgroundAssets": {
        "light": "assets/bottom-bar/backgrounds/bottom-bar-home-bg-light.svg",
        "dark": "assets/bottom-bar/backgrounds/bottom-bar-home-bg-dark.svg"
      },
      "requiredNodes": [
        "backgroundAsset",
        "inputContainer",
        "inputModeToggle",
        "sceneEntries",
        "safeArea"
      ],
      "sceneEntries": {
        "availablePool": [
          "watchHold",
          "trade",
          "paperTrade"
        ],
        "renderingRule": "Render only entries required by page context or user request; paperTrade is explicit-only.",
        "tradeEntryAssets": {
          "defaultIconLight": "assets/bottom-bar/icons/bottom-bar-entry-trade-icon-default-light.png",
          "defaultIconDark": "assets/bottom-bar/icons/bottom-bar-entry-trade-icon-default-dark.png",
          "defaultTextLight": "assets/bottom-bar/icons/bottom-bar-entry-trade-text-default-light.png",
          "defaultTextDark": "assets/bottom-bar/icons/bottom-bar-entry-trade-text-default-dark.png",
          "activeLight": "assets/bottom-bar/icons/bottom-bar-entry-trade-active-light.png",
          "activeDark": "assets/bottom-bar/icons/bottom-bar-entry-trade-active-dark.png"
        },
        "forbiddenForTradeEntry": [
          "assets/bottom-bar/icons/bottom-bar-action-buy-light.png",
          "assets/bottom-bar/icons/bottom-bar-action-buy-dark.png",
          "assets/bottom-bar/icons/bottom-bar-action-sell-light.png",
          "assets/bottom-bar/icons/bottom-bar-action-sell-dark.png",
          "assets/bottom-bar/icons/bottom-bar-action-cancel-light.png",
          "assets/bottom-bar/icons/bottom-bar-action-cancel-dark.png"
        ]
      },
      "horizontalLayout": {
        "frameWidth": 390,
        "frameHeight": 130,
        "bodyBottom": 34,
        "bodyHeight": 48,
        "leftEntry": {
          "type": "trade",
          "x": 16,
          "width": 48,
          "height": 48
        },
        "rightEntry": {
          "type": "watchHold",
          "right": 21,
          "width": 48,
          "height": 48
        },
        "inputPill": {
          "placement": "betweenEntries",
          "width": "auto",
          "resolvedWidthAt390": 225,
          "height": 48,
          "radius": 999
        },
        "gaps": {
          "leftEntryToInput": 16,
          "inputToRightEntry": 16
        },
        "horizontalModel": "left 16 + trade 48 + gap 16 + input auto + gap 16 + watchHold 48 + right 21",
        "visualOrder": [
          "trade",
          "inputPill",
          "watchHold"
        ],
        "appliesTo": "首页 primaryPage bottom bar with trade and watchHold entries"
      }
    },
    "chatPage": {
      "appliesTo": [
        "AI对话页",
        "chat composer"
      ],
      "metrics": {
        "bodyHeight": 89,
        "shadowHeight": 171,
        "inputHeight": 48,
        "safeAreaHeight": 34,
        "agentRowHeight": 26,
        "contentToBodyGap": 20
      },
      "backgroundAssets": {
        "light": "assets/bottom-bar/backgrounds/bottom-bar-chat-bg-light.svg",
        "dark": "assets/bottom-bar/backgrounds/bottom-bar-chat-bg-dark.svg"
      },
      "requiredNodes": [
        "backgroundAsset",
        "inputContainer",
        "inputModeToggle",
        "agentRow",
        "safeArea"
      ],
      "states": [
        "default",
        "messageHint",
        "hasInput",
        "hasInputWithMessageHint",
        "generating"
      ],
      "horizontalLayout": {
        "frameWidth": 390,
        "frameHeight": 171,
        "bodyHeight": 89,
        "safeAreaHeight": 34,
        "inputRowHeight": 48,
        "agentRowHeight": 26,
        "rowOrder": [
          "inputRow",
          "agentRow"
        ],
        "leftEntry": {
          "type": "trade",
          "x": 16,
          "width": 48,
          "height": 48
        },
        "rightEntry": {
          "type": "watchHold",
          "right": 21,
          "width": 48,
          "height": 48
        },
        "inputPill": {
          "placement": "betweenEntries",
          "width": "auto",
          "resolvedWidthAt390": 225,
          "height": 48,
          "radius": 999,
          "inputModeTogglePlacement": "insideRight"
        },
        "gaps": {
          "leftEntryToInput": 16,
          "inputToRightEntry": 16
        },
        "horizontalModel": "left 16 + trade 48 + gap 16 + input auto + gap 16 + watchHold 48 + right 21",
        "forbidden": [
          "inputModeToggle outside input pill",
          "pause outside input pill"
        ],
        "inputToAgentRowGap": 15
      }
    },
    "stockQuotePage": {
      "appliesTo": [
        "个股行情页",
        "stock quote page"
      ],
      "metrics": {
        "bodyHeight": 131,
        "shadowHeight": 179,
        "inputHeight": 48,
        "safeAreaHeight": 34,
        "quoteInfoHeight": 34,
        "contentToBodyGap": 20
      },
      "backgroundAssets": {
        "light": "assets/bottom-bar/backgrounds/bottom-bar-stock-quote-bg-light.svg",
        "dark": "assets/bottom-bar/backgrounds/bottom-bar-stock-quote-bg-dark.svg"
      },
      "requiredNodes": [
        "backgroundAsset",
        "quoteInfoRow",
        "inputContainer",
        "quoteActions",
        "safeArea"
      ],
      "quoteActions": [
        "buy",
        "sell",
        "cancel"
      ],
      "quoteActionsContext": "Only stockQuotePage or an explicitly equivalent quote-detail bottom action bar may render buy/sell/cancel quoteActions.",
      "indexInfoMaterial": {
        "layerOrder": [
          "backgroundAsset/shadow layer",
          "quotePanel/body panel layer",
          "quoteInfoRow",
          "divider",
          "operationRow",
          "safeArea"
        ],
        "backgroundAssetShadowLayer": {
          "height": 179,
          "light": "assets/bottom-bar/backgrounds/bottom-bar-stock-quote-bg-light.svg",
          "dark": "assets/bottom-bar/backgrounds/bottom-bar-stock-quote-bg-dark.svg",
          "clippedByTopRadius": false
        },
        "quotePanel": {
          "radius": "20px 20px 0 0",
          "light": {
            "background": "linear-gradient(190deg, #FFF 10.1%, #FFF 90.77%)",
            "shadow": "0 0 20px 0 rgba(107, 186, 240, 0.25)",
            "backdropFilter": "blur(15px)",
            "stroke": {
              "type": "independentGradientStroke",
              "width": 0.5,
              "direction": "190deg"
            },
            "blurredShapes": [
              {
                "name": "lightBlobOne",
                "size": [
                  218,
                  106
                ],
                "fill": "#758AA0",
                "opacity": 0.5,
                "blur": 100,
                "requiredAsIndependentLayer": true
              },
              {
                "name": "lightBlobTwo",
                "size": [
                  259.854,
                  106
                ],
                "fill": "#BACCDF",
                "opacity": 0.4,
                "blur": 60,
                "requiredAsIndependentLayer": true
              }
            ],
            "forbiddenApproximation": [
              "radial-gradient",
              "single merged glow",
              "ordinary background layer"
            ]
          },
          "dark": {
            "backgroundLayers": [
              "linear-gradient(160deg, rgba(36, 54, 103, 0.40) -7.33%, rgba(18, 26, 54, 0.01) 52.57%)",
              "#051027"
            ],
            "stroke": {
              "type": "independentGradientStroke",
              "value": "linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0))"
            },
            "forbiddenApproximation": [
              "solid white border",
              "white panel background",
              "stroke covering background"
            ]
          }
        }
      }
    }
  },
  "inputTypography": {
    "voiceDefault": {
      "text": "按住说话",
      "fontFamily": "PingFang SC",
      "fontWeight": 500,
      "fontSize": 16,
      "token": "xzl/color/primary/dark-blue",
      "contentAlignment": "icon plus text group centered"
    },
    "textDefault": {
      "text": "提问或搜索",
      "fontFamily": "PingFang SC",
      "fontWeight": 400,
      "fontSize": 16,
      "token": "xzl/color/text/quaternary",
      "darkResolvedValue": "#FFFFFF 30%"
    },
    "enteredText": {
      "fontFamily": "PingFang SC",
      "fontSize": 16,
      "token": "xzl/color/text/primary"
    }
  },
  "iconMetrics": {
    "sceneEntry": {
      "layoutBox": [
        48,
        48
      ],
      "hitArea": [
        48,
        48
      ],
      "defaultVisualSize": [
        48,
        48
      ],
      "selectedVisualBounds": [
        86,
        86
      ],
      "selectedAnchor": "center of 48x48 layout box",
      "selectedVisualBoundsAreLayout": false
    },
    "quoteAction": {
      "visualSize": [
        48,
        48
      ],
      "hitArea": [
        48,
        48
      ]
    },
    "inputModeToggle": {
      "visualSize": [
        30,
        30
      ],
      "hitArea": [
        30,
        30
      ],
      "semantic": "icon shows the next available input mode"
    },
    "voiceInputIcon": {
      "visualSize": [
        13,
        16
      ]
    },
    "pauseVoiceInput": {
      "visualSize": [
        14,
        14
      ],
      "hitArea": [
        14,
        14
      ]
    },
    "pauseTextInput": {
      "visualSize": [
        30,
        30
      ],
      "hitArea": [
        30,
        30
      ]
    },
    "agentIcon": {
      "visualSize": [
        14,
        14
      ],
      "independentHitArea": false
    },
    "rightExpand": {
      "visualSize": [
        14,
        14
      ],
      "asset": "assets/icons/xzl-right-outlined.svg"
    },
    "upDownExpand": {
      "visualSize": [
        18,
        18
      ],
      "assets": [
        "assets/icons/xzl-arrow-up.svg",
        "assets/icons/xzl-arrow-down.svg"
      ],
      "usage": "stockQuotePage indexInfo expand/collapse arrow; collapsed indexInfo uses up when the next motion expands upward, expanded indexInfo uses down when the next motion collapses downward",
      "token": "xzl/color/text/tertiary",
      "resolvedColor": {
        "light": "#6D778B",
        "dark": "50% #FFFFFF"
      },
      "assetBinding": "shared component-library SVG shape with currentColor/token binding",
      "stateAssets": {
        "collapsedExpandUp": "assets/icons/xzl-arrow-up.svg",
        "expandedCollapseDown": "assets/icons/xzl-arrow-down.svg"
      }
    }
  },
  "stateAssets": {
    "inputMode": {
      "voice": {
        "light": "assets/bottom-bar/icons/bottom-bar-mode-voice-light.svg",
        "dark": "assets/bottom-bar/icons/bottom-bar-mode-voice-dark.svg",
        "semanticIcon": "voice toggle asset family; use when current inputMode is text because the next mode is voice input",
        "notes": "This key names the toggle icon family, not current inputMode binding."
      },
      "keyboard": {
        "light": "assets/bottom-bar/icons/bottom-bar-mode-keyboard-light.svg",
        "dark": "assets/bottom-bar/icons/bottom-bar-mode-keyboard-dark.svg",
        "semanticIcon": "keyboard toggle asset family; use when current inputMode is voice because the next mode is keyboard/text input",
        "notes": "This key names the toggle icon family, not current inputMode binding."
      },
      "toggleShowsNextMode": true,
      "assetWhenCurrentModeIsText": {
        "meaning": "switch to voice input",
        "light": "assets/bottom-bar/icons/bottom-bar-mode-voice-light.svg",
        "dark": "assets/bottom-bar/icons/bottom-bar-mode-voice-dark.svg",
        "forbidden": [
          "assets/bottom-bar/icons/bottom-bar-mode-keyboard-light.svg",
          "assets/bottom-bar/icons/bottom-bar-mode-keyboard-dark.svg"
        ]
      },
      "assetWhenCurrentModeIsVoice": {
        "meaning": "switch to keyboard/text input",
        "light": "assets/bottom-bar/icons/bottom-bar-mode-keyboard-light.svg",
        "dark": "assets/bottom-bar/icons/bottom-bar-mode-keyboard-dark.svg",
        "forbidden": [
          "assets/bottom-bar/icons/bottom-bar-mode-voice-light.svg",
          "assets/bottom-bar/icons/bottom-bar-mode-voice-dark.svg"
        ]
      },
      "darkTextDefaultForbiddenAsset": "assets/bottom-bar/icons/bottom-bar-mode-keyboard-dark.svg",
      "notes": "inputModeToggle displays the next available input mode. Bind by current inputMode using assetWhenCurrentModeIsText/Voice; legacy voice/keyboard keys are icon families only."
    },
    "quoteActions": {
      "buy": {
        "light": "assets/bottom-bar/icons/bottom-bar-action-buy-light.png",
        "dark": "assets/bottom-bar/icons/bottom-bar-action-buy-dark.png"
      },
      "sell": {
        "light": "assets/bottom-bar/icons/bottom-bar-action-sell-light.png",
        "dark": "assets/bottom-bar/icons/bottom-bar-action-sell-dark.png"
      },
      "cancel": {
        "light": "assets/bottom-bar/icons/bottom-bar-action-cancel-light.png",
        "dark": "assets/bottom-bar/icons/bottom-bar-action-cancel-dark.png"
      }
    }
  },
  "inputPill": {
    "height": 48,
    "radius": 999,
    "light": {
      "background": "#FFFFFF 60% -> #FFFFFF 90%",
      "border": "0.6px #CDDCF5"
    },
    "darkVoice": {
      "backgroundLayers": [
        "linear-gradient(245deg, rgba(60,114,255,0) 69.18%, rgba(60,114,255,0.20) 96.58%)",
        "linear-gradient(128deg, rgba(255,57,71,0) 64%, rgba(255,57,70,0.20) 104.31%)",
        "linear-gradient(102deg, #8BE5FF -13.88%, #D1F0FF 37.07%, #C7E9FF 57.32%, #8ABFFF 104.19%)"
      ],
      "border": "#FFFFFF 80% -> #FFFFFF 29%",
      "innerShadow": "0 0 4px rgba(62,65,122,0.24) inset"
    },
    "darkText": {
      "background": "#FFFFFF 8%",
      "border": "#FFFFFF 8% -> #FFFFFF 3%"
    }
  },
  "agentChip": {
    "background": "#799FFF 10%",
    "defaultBorder": "none",
    "text": {
      "fontFamily": "PingFang SC",
      "fontWeight": 400,
      "fontSize": 12
    },
    "icon": {
      "size": [
        14,
        14
      ],
      "assetPattern": "assets/bottom-bar/icons/bottom-bar-agent-*.svg",
      "colorBinding": {
        "light": "#2D3A67",
        "dark": "#B2CFFF"
      }
    },
    "padding": {
      "leftRight": 12,
      "topBottom": 4
    },
    "iconTextGap": 2,
    "colors": {
      "light": "#2D3A67",
      "dark": "#B2CFFF"
    },
    "deepThinkingSelected": {
      "background": "#799FFF 10%",
      "borderWidth": 0.5,
      "borderColor": {
        "light": "#2D3A67",
        "dark": "#B2CFFF"
      },
      "asset": {
        "light": "assets/bottom-bar/icons/deep-thinking-selected-light.svg",
        "dark": "assets/bottom-bar/icons/deep-thinking-selected-dark.svg"
      },
      "requiresState": "thinkingMode: selected | unselected"
    },
    "taskAssistant": {
      "structure": [
        "agentIcon",
        "text",
        "divider",
        "rightArrow"
      ],
      "contentAlignment": "center",
      "textToDividerGap": 6,
      "dividerToArrowGap": 6,
      "divider": {
        "height": 12,
        "thickness": 0.5,
        "color": {
          "light": "#2D3A67 50%",
          "dark": "#B2CFFF 50%"
        }
      },
      "rightArrow": {
        "asset": "assets/icons/xzl-right-outlined.svg",
        "size": [
          14,
          14
        ],
        "color": {
          "light": "#2D3A67",
          "dark": "#B2CFFF"
        },
        "colorBinding": "icon component color/state binding"
      }
    }
  }
}
