{
  "name": "holding-table-module",
  "description": "Required structure template for 持仓列表 and 持股列表 modules, including the holdings column model, frozen identity column, synchronized scrolling data columns, and the 持股-only left frozen header.",
  "appliesTo": [
    "holdings table",
    "持仓列表",
    "持股列表"
  ],
  "requiredReferences": [
    "references/lists/table-generation-protocol.md",
    "references/lists/financial-table-list.md",
    "references/lists/holdings.md",
    "references/lists/holdings-generation-contract.md",
    "references/tags/security-tags.md"
  ],
  "module": {
    "type": "financialTableList",
    "scenario": "holdings",
    "pageContainerAllowed": true,
    "pageChromeMayExist": true,
    "pageChromeCannotReplaceModule": true,
    "frozenHeader": {
      "width": 143,
      "columnId": "name",
      "holdingListTemplate": "assets/templates/holding-list-left-header.json",
      "useHoldingListTemplateOnlyFor": "持股列表",
      "ordinaryHoldingsHeader": {
        "field": "名称",
        "headerTemplate": "assets/templates/filterable-table-header.json",
        "filterable": true,
        "mustNotUseWatchlistHeaderTools": true
      }
    },
    "scrollHeader": {
      "sharesHorizontalScrollStateWithBody": true,
      "headerCannotScrollIndependently": true,
      "columns": [
        {
          "field": "持仓金额",
          "width": 70,
          "filterable": false,
          "columnId": "positionAmount",
          "alignment": "right"
        },
        {
          "field": "持仓盈亏",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "positionProfitLoss",
          "alignment": "right",
          "dualLine": true
        },
        {
          "field": "持仓/可用",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "holdingAvailable",
          "alignment": "right",
          "dualLine": true
        },
        {
          "field": "现价/成本",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "priceCost",
          "alignment": "right",
          "dualLine": true
        },
        {
          "field": "今日盈亏",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "todayProfitLoss",
          "alignment": "right"
        },
        {
          "field": "个股仓位",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "positionRatio",
          "alignment": "right"
        },
        {
          "field": "持仓天数",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "holdingDays",
          "alignment": "right"
        },
        {
          "field": "买入均价",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "averageBuyPrice",
          "alignment": "right"
        },
        {
          "field": "代码",
          "width": 70,
          "filterable": false,
          "columnId": "stockCode",
          "alignment": "right"
        },
        {
          "field": "最新",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "latest",
          "alignment": "right"
        },
        {
          "field": "涨幅",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changePercent",
          "alignment": "right"
        },
        {
          "field": "涨跌",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changeAmount",
          "alignment": "right"
        },
        {
          "field": "涨速",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "changeSpeed",
          "alignment": "right"
        },
        {
          "field": "成交额",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "turnoverAmount",
          "alignment": "right"
        },
        {
          "field": "换手率",
          "width": 70,
          "headerTemplate": "assets/templates/filterable-table-header.json",
          "filterable": true,
          "columnId": "turnoverRate",
          "alignment": "right",
          "finalColumnRequiresRightSafetyPadding": 18
        }
      ]
    },
    "frozenRows": {
      "width": 143,
      "columnId": "name",
      "ordinaryHoldingsChildren": [
        "stockName",
        "marketValueAmount"
      ],
      "holdingListChildren": [
        "stockName",
        "marketValueAmount",
        "tradeTypeTag"
      ],
      "holdingListRules": {
        "line1": "stockName",
        "line2": [
          "marketValueAmount",
          "tradeTypeTag"
        ],
        "showStockCode": false,
        "showSecurityTags": false,
        "tradeTypeTagsOnly": [
          "条件单",
          "信用"
        ]
      }
    },
    "scrollRows": {
      "sharesColumnModelWithHeader": true,
      "cellsUseColumnIdsFromColumnModel": true,
      "noMiniTrendCharts": true,
      "dualLineFields": [
        "positionProfitLoss",
        "holdingAvailable",
        "priceCost"
      ]
    },
    "generationOrder": [
      "defineColumnModel",
      "renderFrozenHeaderFromColumnModel",
      "renderScrollHeaderFromColumnModel",
      "renderFrozenRowsFromColumnModel",
      "renderScrollRowsFromColumnModel",
      "bindHeaderAndBodyToOneHorizontalScrollState",
      "verifyFinalColumnFullyVisible"
    ],
    "columnModel": [
      {
        "columnId": "name",
        "field": "名称",
        "width": 143,
        "role": "frozenIdentity",
        "alignment": "left"
      },
      {
        "columnId": "positionAmount",
        "field": "持仓金额",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": false
      },
      {
        "columnId": "positionProfitLoss",
        "field": "持仓盈亏",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "dualLine": true,
        "movementField": true
      },
      {
        "columnId": "holdingAvailable",
        "field": "持仓/可用",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "dualLine": true
      },
      {
        "columnId": "priceCost",
        "field": "现价/成本",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "dualLine": true
      },
      {
        "columnId": "todayProfitLoss",
        "field": "今日盈亏",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "movementField": true
      },
      {
        "columnId": "positionRatio",
        "field": "个股仓位",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true
      },
      {
        "columnId": "holdingDays",
        "field": "持仓天数",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true
      },
      {
        "columnId": "averageBuyPrice",
        "field": "买入均价",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true
      },
      {
        "columnId": "stockCode",
        "field": "代码",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": false
      },
      {
        "columnId": "latest",
        "field": "最新",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true
      },
      {
        "columnId": "changePercent",
        "field": "涨幅",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "movementField": true
      },
      {
        "columnId": "changeAmount",
        "field": "涨跌",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "movementField": true
      },
      {
        "columnId": "changeSpeed",
        "field": "涨速",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "movementField": true
      },
      {
        "columnId": "turnoverAmount",
        "field": "成交额",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true
      },
      {
        "columnId": "turnoverRate",
        "field": "换手率",
        "width": 70,
        "role": "scrollingData",
        "alignment": "right",
        "filterable": true,
        "finalColumn": true
      }
    ]
  },
  "validation": [
    "Define the holdings columnModel before rendering header or row cells.",
    "For 持股列表, instantiate holdingLeftHeaderTools from assets/templates/holding-list-left-header.json.",
    "Do not use watchlistHeaderTools in holdings or 持股列表.",
    "Header and body cells must reference the same columnId values.",
    "Filterable holdings headers must instantiate assets/templates/filterable-table-header.json.",
    "持股 frozen rows show stock name on line 1 and market value amount plus optional trade-type tag on line 2.",
    "持股 frozen rows must not show stock code or security/market tags.",
    "Holdings rows do not include mini trend charts.",
    "The final scrolling column must be fully reachable with 18px right safety padding.",
    "Divider overlays must render above frozen and scrolling layers."
  ]
}
