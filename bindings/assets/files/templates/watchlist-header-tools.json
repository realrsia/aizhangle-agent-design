{
  "name": "watchlist-header-tools",
  "description": "Rendered-node template for the watchlist-only left header operation area.",
  "appliesTo": [
    "watchlist",
    "自选列表"
  ],
  "notAppliesTo": [
    "holdings",
    "持仓列表",
    "other financial lists"
  ],
  "node": {
    "name": "watchlistHeaderTools",
    "renderedNodeRequired": true,
    "documentationOnly": false,
    "width": 123,
    "xStart": 0,
    "fixedLayer": true,
    "displayNameCodeText": false,
    "children": [
      {
        "name": "编辑",
        "type": "iconButton",
        "asset": "assets/icons/watchlist-header-edit.svg",
        "required": true,
        "clickable": true,
        "renderedNodeRequired": true,
        "documentationOnly": false,
        "ariaLabel": "编辑"
      },
      {
        "name": "标签视图切换",
        "type": "iconButton",
        "asset": "assets/icons/watchlist-header-tag-view.svg",
        "required": true,
        "clickable": true,
        "renderedNodeRequired": true,
        "documentationOnly": false,
        "ariaLabel": "标签视图切换"
      },
      {
        "name": "多股",
        "type": "iconButton",
        "asset": "assets/icons/watchlist-header-multi-stock.svg",
        "required": true,
        "clickable": true,
        "renderedNodeRequired": true,
        "documentationOnly": false,
        "ariaLabel": "多股"
      },
      {
        "name": "横屏",
        "type": "iconButton",
        "asset": "assets/icons/watchlist-header-landscape.svg",
        "required": true,
        "clickable": true,
        "renderedNodeRequired": true,
        "documentationOnly": false,
        "ariaLabel": "横屏"
      }
    ]
  },
  "layout": {
    "direction": "left-to-right",
    "firstIconX": 0,
    "iconSize": {
      "width": 16,
      "height": 16
    },
    "iconGap": 9.5,
    "iconColorToken": "xzl/color/text/tertiary",
    "outsideHorizontalScrollContainer": true
  },
  "validation": [
    "This template is watchlist-only and must not be used by holdings or other list types.",
    "The header cell must not render 名称代码 text.",
    "All four icon buttons must exist as rendered child nodes.",
    "Asset paths in notes are not enough; the visual/structure tree must contain the icon nodes.",
    "Each icon button must be clickable and semantically labelled."
  ]
}
